{
  "expo": {
    "name": "Music&Color",
    "slug": "sinestezia",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0e0e12",
    "android": {
      "package": "com.tskyes.musiccolor",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.tskyes.musiccolor"
    },
    "scheme": "musiccolor",
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Music&Color salvează imaginile create în galerie.",
          "savePhotosPermission": "Music&Color salvează imaginile create în galerie.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo",
            "audio"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Music&Color citește imaginea aleasă pentru a crea melodia.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/withConfigChanges",
      "./plugins/withTrimPermissions"
    ]
  }
}
